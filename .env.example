# Groq LLM (required for suggestions; without it the agent safely escalates everything)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b,openai/gpt-oss-20b

# Hindsight memory. Leave HINDSIGHT_BASE_URL empty to use the local stand-in (var/local_memory.json).
# Cloud: https://api.hindsight.vectorize.io   Self-hosted Docker: http://localhost:8888
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=ledgerlens-ap
